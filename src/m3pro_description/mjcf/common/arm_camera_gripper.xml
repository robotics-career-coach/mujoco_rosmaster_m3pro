          material="camera_body"/>
    <camera name="depth_camera_rgb" pos="0 0.025 0" quat="0.5 0.5 -0.5 0.5"
            fovy="58" resolution="640 480"/>
    <camera name="depth_camera_depth" pos="0 0.025 0" quat="0.5 0.5 -0.5 0.5"
            fovy="58" resolution="640 480"/>
  </body>


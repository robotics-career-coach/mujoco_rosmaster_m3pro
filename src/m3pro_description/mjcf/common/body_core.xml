<mujocoinclude>
  <!-- Base chassis geoms + IMU site, common to every base variant. Included
       directly inside <body name="base_link">; the joint(s) that give
       base_link its degrees of freedom (freejoint for contact-driven
       variants, planar slide/hinge joints for the kinematic variant) are
       variant-specific and declared in each bases/<variant> assembler. -->
  <inertial pos="-0.0231 -0.000624 0.0924" mass="0.871"
            diaginertia="0.000965 0.000924 0.00167"/>

  <geom name="base_visual" type="mesh" mesh="base_link" class="visual"
        material="black_aluminum"/>
  <geom name="base_collision" type="box" class="collision"
        pos="-0.005 0 0.09" size="0.12 0.09 0.06"/>

  <geom name="arm_base_visual" type="mesh" mesh="arm_base_Link" class="visual"
        pos="0.033617 -1.0031e-05 0" quat="1 3.18755e-05 0 0"
        material="green_pcb"/>

  <site name="imu_site" pos="0 0 0.07" size="0.005" rgba="1 0 0 0.5"/>
</mujocoinclude>

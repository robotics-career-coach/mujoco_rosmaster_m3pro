<mujoco>
  <compiler angle="radian" meshdir="../meshes"/>

  <default>
    <geom contype="1" conaffinity="1"/>
    <joint damping="0.5" armature="0.01"/>

    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>

    <default class="collision">
      <geom group="3" rgba="0.5 0.5 0.5 0.3"/>
    </default>

    <default class="wheel_contact">
      <geom contype="1" conaffinity="0" group="3" rgba="0.5 0.5 0.5 0.3"/>
    </default>
  </default>

  <include file="common/assets.xml"/>

  <worldbody>
    <body name="base_link" pos="0 0 0.042">
      <freejoint name="base_freejoint"/>
      <include file="common/body_core.xml"/>
      <include file="bases/mecanum/wheels.xml"/>
      <include file="common/arm_camera_gripper.xml"/>
    </body>
  </worldbody>

  <include file="common/gripper_equality.xml"/>

  <include file="common/wheel_actuators.xml"/>
  <include file="common/arm_actuators.xml"/>

  <include file="common/imu_arm_sensors.xml"/>
  <include file="common/wheel_sensors.xml"/>
</mujoco>

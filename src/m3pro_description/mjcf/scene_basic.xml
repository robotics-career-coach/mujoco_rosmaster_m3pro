<mujoco model="m3pro_basic">
  <include file="m3pro_robot.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global azimuth="135" elevation="-25"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" rgb1="0.55 0.55 0.55" rgb2="0.65 0.65 0.65" width="512" height="512" mark="edge" markrgb="0.5 0.5 0.5"/>
    <material name="groundplane" texture="groundplane" texrepeat="5 5" texuniform="true" reflectance="0.05"/>
    <material name="table_wood" rgba="0.6 0.4 0.2 1" specular="0.3" shininess="0.2"/>
    <material name="red_plastic" rgba="0.8 0.15 0.1 1" specular="0.4" shininess="0.3"/>
    <material name="blue_plastic" rgba="0.1 0.3 0.8 1" specular="0.4" shininess="0.3"/>
    <material name="wall_concrete" rgba="0.7 0.7 0.72 1" specular="0.2" shininess="0.1"/>
    <material name="ramp_wood" rgba="0.5 0.35 0.2 1" specular="0.2" shininess="0.1"/>
    <material name="green_plastic" rgba="0.1 0.7 0.2 1" specular="0.4" shininess="0.3"/>
  </asset>

  <worldbody>
    <light name="top_light" pos="0 0 3" dir="0 0 -1" diffuse="0.9 0.9 0.9" specular="0.4 0.4 0.4" castshadow="true"/>
    <light name="side_light" pos="2 -2 2" dir="-1 1 -1" diffuse="0.5 0.5 0.5" specular="0.2 0.2 0.2"/>
    <light name="fill_light" pos="-2 2 2" dir="1 -1 -1" diffuse="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <camera name="tracking" pos="0.6 -0.8 0.5" xyaxes="0.8 0.6 0 -0.25 0.33 0.91" mode="trackcom"/>
    <camera name="overview" pos="1.5 -1.5 2.5" xyaxes="0.707 0.707 0 -0.35 0.35 0.87" mode="fixed"/>

    <geom name="ground" type="plane" size="5 5 0.1" material="groundplane"/>

    <!-- ==================== Table ==================== -->
    <!-- Low table within arm reach (top surface at z=0.252) -->
    <body name="table" pos="0.45 0 0">
      <geom name="table_top" type="box" pos="0 0 0.24" size="0.2 0.15 0.012"
            material="table_wood" mass="5"/>
      <geom name="table_leg_fl" type="cylinder" pos="0.16 0.12 0.114" size="0.015 0.114"
            material="table_wood"/>
      <geom name="table_leg_fr" type="cylinder" pos="0.16 -0.12 0.114" size="0.015 0.114"
            material="table_wood"/>
      <geom name="table_leg_rl" type="cylinder" pos="-0.16 0.12 0.114" size="0.015 0.114"
            material="table_wood"/>
      <geom name="table_leg_rr" type="cylinder" pos="-0.16 -0.12 0.114" size="0.015 0.114"
            material="table_wood"/>
    </body>

    <!-- ==================== Graspable Objects ==================== -->
    <!-- Red box on table -->
    <body name="red_box" pos="0.45 0.05 0.272">
      <freejoint name="red_box_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="1.3e-5 1.3e-5 1.3e-5"/>
      <geom name="red_box_geom" type="box" size="0.02 0.02 0.02"
            material="red_plastic" friction="1.0 0.5 0.01"/>
    </body>

    <!-- Blue cylinder on table -->
    <body name="blue_cylinder" pos="0.42 -0.05 0.277">
      <freejoint name="blue_cylinder_joint"/>
      <inertial pos="0 0 0" mass="0.03" diaginertia="5e-6 5e-6 8e-6"/>
      <geom name="blue_cylinder_geom" type="cylinder" size="0.015 0.025"
            material="blue_plastic" friction="1.0 0.5 0.01"/>
    </body>

    <!-- Green sphere on floor (push target) -->
    <body name="green_ball" pos="0.8 0.3 0.03">
      <freejoint name="green_ball_joint"/>
      <inertial pos="0 0 0" mass="0.1" diaginertia="3.6e-5 3.6e-5 3.6e-5"/>
      <geom name="green_ball_geom" type="sphere" size="0.03"
            material="green_plastic" friction="0.8 0.3 0.01"/>
    </body>

    <!-- ==================== Walls / Barriers ==================== -->
    <geom name="wall_front" type="box" pos="1.5 0 0.15" size="0.05 0.8 0.15"
          material="wall_concrete"/>
    <geom name="wall_right" type="box" pos="0.75 -0.8 0.15" size="0.8 0.05 0.15"
          material="wall_concrete"/>
    <geom name="wall_left_short" type="box" pos="0.9 0.6 0.1" size="0.4 0.05 0.1"
          material="wall_concrete"/>

    <!-- Small box obstacle on the floor -->
    <geom name="floor_obstacle" type="box" pos="0.9 -0.3 0.05" size="0.08 0.08 0.05"
          material="wall_concrete"/>

    <!-- ==================== Ramp ==================== -->
    <!-- Gentle ramp behind robot for wheel traction testing -->
    <body name="ramp" pos="-0.5 0 0">
      <geom name="ramp_surface" type="box" pos="0 0 0.038" size="0.2 0.15 0.008"
            euler="0 0.15 0" material="ramp_wood" mass="10" friction="1.5 0.5 0.01"/>
    </body>
  </worldbody>
</mujoco>

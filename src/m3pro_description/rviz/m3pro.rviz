Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      TF Prefix: ""

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15

    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Line Style:
        Value: Lines
      Color: 160; 160; 164
      Plane Cell Count: 20

    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Front
      Enabled: true
      Topic:
        Value: /lidar_front/scan
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 0; 255; 0

    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Rear
      Enabled: true
      Topic:
        Value: /lidar_rear/scan
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 255; 255; 0

    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Topic:
        Value: /depth_camera_rgb/color

    - Class: rviz_default_plugins/Image
      Name: Depth Camera
      Enabled: true
      Topic:
        Value: /depth_camera_depth/depth

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /mecanum_drive_controller/odometry
      Keep: 1
      Shape:
        Value: Arrow
        Shaft Length: 0.08
        Shaft Radius: 0.01
        Head Length: 0.03
        Head Radius: 0.02
      Covariance:
        Value: false

  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.1
      Pitch: 0.5
      Yaw: 2.3

#!/usr/bin/env python3
"""Publishes MJCF XML to /mujoco_robot_description for mujoco_ros2_control."""
import os
import re
import sys
import xml.etree.ElementTree as ET
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, DurabilityPolicy, HistoryPolicy
from std_msgs.msg import String


def resolve_includes(xml_string, base_dir):
    """Recursively resolve MuJoCo <include file="..."/> directives.

    Replicates MuJoCo's native include semantics: matching sections have their
    children appended; new sections are inserted at the include position.
    Relative meshdir/assetdir paths in included files are made absolute.
    """
    root = ET.fromstring(xml_string)

    while True:
        include = root.find('include')
        if include is None:
            break

        inc_file = include.get('file')
        if not inc_file:
            root.remove(include)
            continue

        inc_path = os.path.normpath(os.path.join(base_dir, inc_file))
        inc_dir = os.path.dirname(inc_path)

        with open(inc_path, 'r') as f:
            inc_content = f.read()

        resolved = resolve_includes(inc_content, inc_dir)
        inc_root = ET.fromstring(resolved)

        for compiler in inc_root.iter('compiler'):
            for attr in ('meshdir', 'assetdir'):
                val = compiler.get(attr)
                if val and not os.path.isabs(val):
                    compiler.set(attr, os.path.normpath(os.path.join(inc_dir, val)))

        idx = list(root).index(include)
        root.remove(include)

        insert_offset = 0
        for child in inc_root:
            existing = root.find(child.tag)
            if existing is not None:
                for attr_name, attr_val in child.attrib.items():
                    if attr_name not in existing.attrib:
                        existing.set(attr_name, attr_val)
                for sub in child:
                    existing.append(sub)
            else:
                root.insert(idx + insert_offset, child)
                insert_offset += 1

    return ET.tostring(root, encoding='unicode')


class MjcfPublisher(Node):
    def __init__(self):
        super().__init__('mjcf_description_publisher')

        self.declare_parameter('mjcf_path', '')
        mjcf_path = self.get_parameter('mjcf_path').get_parameter_value().string_value

        if not mjcf_path:
            self.get_logger().fatal('mjcf_path parameter is required')
            sys.exit(1)

        try:
            with open(mjcf_path, 'r') as f:
                mjcf_content = f.read()
        except OSError as e:
            self.get_logger().fatal(f'Cannot read MJCF file: {e}')
            sys.exit(1)

        mjcf_dir = os.path.dirname(os.path.abspath(mjcf_path))

        mjcf_content = resolve_includes(mjcf_content, mjcf_dir)

        # MuJoCo has no file path anchor when loading from a string, so relative
        # meshdir/assetdir values fail. Rewrite them to absolute paths.
        def abs_attr(match):
            attr, rel = match.group(1), match.group(2)
            abs_path = os.path.normpath(os.path.join(mjcf_dir, rel))
            return f'{attr}="{abs_path}"'

        mjcf_content = re.sub(
            r'(meshdir|assetdir)="([^"]+)"', abs_attr, mjcf_content
        )

        # Latching QoS — new subscribers receive the last message immediately
        qos = QoSProfile(
            depth=1,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
            history=HistoryPolicy.KEEP_LAST,
        )

        self.pub = self.create_publisher(String, '/mujoco_robot_description', qos)
        msg = String()
        msg.data = mjcf_content
        self.pub.publish(msg)
        self.get_logger().info(f'Published MJCF from {mjcf_path}')


def main():
    rclpy.init()
    node = MjcfPublisher()
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == '__main__':
    main()

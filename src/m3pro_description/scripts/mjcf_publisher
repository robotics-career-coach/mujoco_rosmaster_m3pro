#!/usr/bin/env python3
"""Publishes MJCF XML to /mujoco_robot_description for mujoco_ros2_control."""
import os
import re
import sys
import xml.etree.ElementTree as ET
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, DurabilityPolicy, HistoryPolicy
from std_msgs.msg import String


# Top-level MJCF section tags: singleton per model, so an <include> contributing
# one of these merges into an existing same-named sibling instead of duplicating
# it. Every other tag (body, geom, joint, site, ...) is repeatable, so matching by
# tag name would wrongly graft a fragment's content onto an unrelated existing
# element (e.g. two <body> children) -- those are always inserted as new siblings.
_MERGEABLE_SECTIONS = {
    'compiler', 'option', 'size', 'visual', 'statistic', 'default', 'custom',
    'asset', 'worldbody', 'contact', 'equality', 'tendon', 'actuator', 'sensor',
    'keyframe',
}


def resolve_includes(xml_string, base_dir):
    """Resolve MuJoCo <include file="..."/> directives at any nesting depth.

    Replicates MuJoCo's native include semantics: matching top-level sections
    have their children appended; everything else is inserted as new siblings
    at the include's position. Relative meshdir/assetdir paths in included
    files are made absolute.
    """
    root = ET.fromstring(xml_string)
    _resolve_element(root, base_dir)
    return ET.tostring(root, encoding='unicode')


def _resolve_element(elem, base_dir):
    """Resolve elem's own <include> children in place, then recurse into elem's
    (now fully-expanded) children to resolve any includes nested deeper."""
    while True:
        include = elem.find('include')
        if include is None:
            break

        inc_file = include.get('file')
        if not inc_file:
            elem.remove(include)
            continue

        inc_path = os.path.normpath(os.path.join(base_dir, inc_file))
        inc_dir = os.path.dirname(inc_path)

        with open(inc_path, 'r') as f:
            inc_content = f.read()

        inc_root = ET.fromstring(inc_content)
        _resolve_element(inc_root, inc_dir)

        for compiler in inc_root.iter('compiler'):
            for attr in ('meshdir', 'assetdir'):
                val = compiler.get(attr)
                if val and not os.path.isabs(val):
                    compiler.set(attr, os.path.normpath(os.path.join(inc_dir, val)))

        idx = list(elem).index(include)
        elem.remove(include)

        insert_offset = 0
        for child in inc_root:
            existing = elem.find(child.tag) if child.tag in _MERGEABLE_SECTIONS else None
            if existing is not None:
                for attr_name, attr_val in child.attrib.items():
                    if attr_name not in existing.attrib:
                        existing.set(attr_name, attr_val)
                for sub in child:
                    existing.append(sub)
            else:
                elem.insert(idx + insert_offset, child)
                insert_offset += 1

    for child in list(elem):
        _resolve_element(child, base_dir)


class MjcfPublisher(Node):
    def __init__(self):
        super().__init__('mjcf_description_publisher')

        self.declare_parameter('mjcf_path', '')
        mjcf_path = self.get_parameter('mjcf_path').get_parameter_value().string_value

        if not mjcf_path:
            self.get_logger().fatal('mjcf_path parameter is required')
            sys.exit(1)

        try:
            with open(mjcf_path, 'r') as f:
                mjcf_content = f.read()
        except OSError as e:
            self.get_logger().fatal(f'Cannot read MJCF file: {e}')
            sys.exit(1)

        mjcf_dir = os.path.dirname(os.path.abspath(mjcf_path))

        mjcf_content = resolve_includes(mjcf_content, mjcf_dir)

        # MuJoCo has no file path anchor when loading from a string, so relative
        # meshdir/assetdir values fail. Rewrite them to absolute paths.
        def abs_attr(match):
            attr, rel = match.group(1), match.group(2)
            abs_path = os.path.normpath(os.path.join(mjcf_dir, rel))
            return f'{attr}="{abs_path}"'

        mjcf_content = re.sub(
            r'(meshdir|assetdir)="([^"]+)"', abs_attr, mjcf_content
        )

        # Latching QoS — new subscribers receive the last message immediately
        qos = QoSProfile(
            depth=1,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
            history=HistoryPolicy.KEEP_LAST,
        )

        self.pub = self.create_publisher(String, '/mujoco_robot_description', qos)
        msg = String()
        msg.data = mjcf_content
        self.pub.publish(msg)
        self.get_logger().info(f'Published MJCF from {mjcf_path}')


def main():
    rclpy.init()
    node = MjcfPublisher()
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == '__main__':
    main()

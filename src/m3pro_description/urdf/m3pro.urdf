<?xml version="1.0"?>
<robot name="m3pro">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.502 0.502 0.502 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.005 0 0.09"/>
      <geometry>
        <box size="0.24 0.18 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0231 -0.000624 0.0924"/>
      <mass value="0.871"/>
      <inertia ixx="0.000924" ixy="0" ixz="0" iyy="0.000965" iyz="0" izz="0.00167"/>
    </inertial>
  </link>

  <!-- Front-left wheel -->
  <link name="lwheel1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/lwheel1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.298 0.298 0.298 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="lwheel1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="lwheel1"/>
    <origin xyz="0.0775754 0.09775 0.04" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Front-right wheel -->
  <link name="rwheel1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rwheel1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="rwheel1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rwheel1"/>
    <origin xyz="0.0775754 -0.09775 0.04" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Rear-left wheel -->
  <link name="lwheel2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/lwheel2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="lwheel2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="lwheel2"/>
    <origin xyz="-0.0814246 0.09775 0.04" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Rear-right wheel -->
  <link name="rwheel2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rwheel2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="rwheel2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rwheel2"/>
    <origin xyz="-0.0814246 -0.09775 0.04" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/Camera.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <inertial>
      <origin xyz="-0.00516 0.01716 0"/>
      <mass value="0.054"/>
      <inertia ixx="3.0e-05" ixy="0" ixz="0" iyy="3.1e-05" iyz="0" izz="5.8e-06"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0909155 0.000198 0.0935" rpy="1.5707963 0 0"/>
  </joint>

  <!-- Camera optical frame -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0.025 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- IMU frame -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.07"/>
  </joint>

  <!-- LiDAR front-left -->
  <link name="lidar_front_link"/>
  <joint name="lidar_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_front_link"/>
    <origin xyz="0.10 0.06 0.10"/>
  </joint>

  <!-- LiDAR rear-right -->
  <link name="lidar_rear_link"/>
  <joint name="lidar_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_rear_link"/>
    <origin xyz="-0.10 -0.06 0.10"/>
  </joint>

  <!-- Arm base (fixed to chassis) -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm_base_Link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.627 0.235 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.00785"/>
      <inertia ixx="3.56e-06" ixy="0" ixz="0" iyy="3.56e-06" iyz="0" izz="7.11e-06"/>
    </inertial>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.033617 0 0"/>
  </joint>

  <!-- Arm joint 1 -->
  <link name="arm1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0244"/>
      <inertia ixx="4.13e-06" ixy="0" ixz="0" iyy="3.52e-06" iyz="0" izz="6.04e-06"/>
    </inertial>
  </link>
  <joint name="arm1_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm1"/>
    <origin xyz="0.033617 0 0.185"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 2 -->
  <link name="arm2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0264"/>
      <mass value="0.0615"/>
      <inertia ixx="2.11e-05" ixy="0" ixz="0" iyy="1.64e-05" iyz="0" izz="9.72e-06"/>
    </inertial>
  </link>
  <joint name="arm2_joint" type="revolute">
    <parent link="arm1"/>
    <child link="arm2"/>
    <origin xyz="0 0 0.033"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 3 -->
  <link name="arm3">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0258"/>
      <mass value="0.0615"/>
      <inertia ixx="2.11e-05" ixy="0" ixz="0" iyy="1.64e-05" iyz="0" izz="9.72e-06"/>
    </inertial>
  </link>
  <joint name="arm3_joint" type="revolute">
    <parent link="arm2"/>
    <child link="arm3"/>
    <origin xyz="0 0 0.08285"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 4 -->
  <link name="arm4">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0.00266 0 0.0318"/>
      <mass value="0.0797"/>
      <inertia ixx="1.75e-05" ixy="0" ixz="0" iyy="1.97e-05" iyz="0" izz="1.24e-05"/>
    </inertial>
  </link>
  <joint name="arm4_joint" type="revolute">
    <parent link="arm3"/>
    <child link="arm4"/>
    <origin xyz="0 0 0.08285"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 5 -->
  <link name="arm5">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0.0186 -0.00247 0.0265"/>
      <mass value="0.0410"/>
      <inertia ixx="5.48e-06" ixy="0" ixz="0" iyy="1.91e-06" iyz="0" izz="5.25e-06"/>
    </inertial>
  </link>
  <joint name="arm5_joint" type="revolute">
    <parent link="arm4"/>
    <child link="arm5"/>
    <origin xyz="0.00057 0 0.074815"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Gripper -->
  <link name="gripper_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/Gripping.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="2.4e-06" ixy="0" ixz="0" iyy="1.5e-06" iyz="0" izz="3.9e-06"/>
    </inertial>
  </link>
  <joint name="rlink1_joint" type="revolute">
    <parent link="arm5"/>
    <child link="gripper_link"/>
    <origin xyz="-0.0048 -0.0126 0.029275" rpy="1.5708 -0.604 -1.5708"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.95" upper="0" effort="100" velocity="1"/>
  </joint>

  <!-- ros2_control hardware interface for MuJoCo -->
  <ros2_control name="mujoco_ros2_control" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
    </hardware>

    <!-- Wheel joints: velocity command, position+velocity state -->
    <joint name="lwheel1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rwheel1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lwheel2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rwheel2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm joints: position command, position+velocity state -->
    <joint name="arm1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm4_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm5_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper joint -->
    <joint name="rlink1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- IMU sensor -->
    <sensor name="imu_sensor">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>

</robot>

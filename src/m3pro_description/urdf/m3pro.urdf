<?xml version="1.0"?>
<robot name="m3pro">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/base_link.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.502 0.502 0.502 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.005 0 0.09"/>
      <geometry>
        <box size="0.24 0.18 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0231 -0.000624 0.0924"/>
      <mass value="0.871"/>
      <inertia ixx="0.000924" ixy="0" ixz="0" iyy="0.000965" iyz="0" izz="0.00167"/>
    </inertial>
  </link>

  <!-- Front-left wheel -->
  <link name="lwheel1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/lwheel1.stl"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.298 0.298 0.298 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="lwheel1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="lwheel1"/>
    <origin xyz="0.0775754 0.09775 0.04" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Front-right wheel -->
  <link name="rwheel1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rwheel1.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="rwheel1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rwheel1"/>
    <origin xyz="0.0775754 -0.09775 0.04" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Rear-left wheel -->
  <link name="lwheel2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/lwheel2.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="lwheel2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="lwheel2"/>
    <origin xyz="-0.0814246 0.09775 0.04" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Rear-right wheel -->
  <link name="rwheel2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rwheel2.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0109"/>
      <geometry>
        <cylinder radius="0.04" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0973"/>
      <inertia ixx="4.45e-05" ixy="0" ixz="0" iyy="4.45e-05" iyz="0" izz="7.46e-05"/>
    </inertial>
  </link>
  <joint name="rwheel2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rwheel2"/>
    <origin xyz="-0.0814246 -0.09775 0.04" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/Camera.stl"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.22 0.22 0.24 1"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.00516 0.01716 0"/>
      <mass value="0.054"/>
      <inertia ixx="3.0e-05" ixy="0" ixz="0" iyy="3.1e-05" iyz="0" izz="5.8e-06"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0909155 0.000198 0.0935" rpy="1.5707963 0 0"/>
  </joint>

  <!-- Camera optical frame -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0.025 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- IMU frame -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.07"/>
  </joint>

  <!-- LiDAR front-left -->
  <link name="lidar_front_link"/>
  <joint name="lidar_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_front_link"/>
    <origin xyz="0.10 0.06 0.10"/>
  </joint>

  <!-- LiDAR rear-right -->
  <link name="lidar_rear_link"/>
  <joint name="lidar_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_rear_link"/>
    <origin xyz="-0.10 -0.06 0.10"/>
  </joint>

  <!-- Arm base (fixed to chassis) -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm_base_Link.stl"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.627 0.235 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.00785"/>
      <inertia ixx="3.56e-06" ixy="0" ixz="0" iyy="3.56e-06" iyz="0" izz="7.11e-06"/>
    </inertial>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.033617 0 0"/>
  </joint>

  <!-- Arm joint 1 -->
  <link name="arm1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm1.stl"/>
      </geometry>
      <material name="blue_servo">
        <color rgba="0.15 0.35 0.7 1"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0109"/>
      <mass value="0.0244"/>
      <inertia ixx="4.13e-06" ixy="0" ixz="0" iyy="3.52e-06" iyz="0" izz="6.04e-06"/>
    </inertial>
  </link>
  <joint name="arm1_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm1"/>
    <origin xyz="0.033617 0 0.185"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 2 -->
  <link name="arm2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm2.stl"/>
      </geometry>
      <material name="silver_bracket">
        <color rgba="0.75 0.75 0.78 1"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0264"/>
      <mass value="0.0615"/>
      <inertia ixx="2.11e-05" ixy="0" ixz="0" iyy="1.64e-05" iyz="0" izz="9.72e-06"/>
    </inertial>
  </link>
  <joint name="arm2_joint" type="revolute">
    <parent link="arm1"/>
    <child link="arm2"/>
    <origin xyz="0 0 0.033"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 3 -->
  <link name="arm3">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm3.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0258"/>
      <mass value="0.0615"/>
      <inertia ixx="2.11e-05" ixy="0" ixz="0" iyy="1.64e-05" iyz="0" izz="9.72e-06"/>
    </inertial>
  </link>
  <joint name="arm3_joint" type="revolute">
    <parent link="arm2"/>
    <child link="arm3"/>
    <origin xyz="0 0 0.08285"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Arm joint 4 -->
  <link name="arm4">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm4.stl"/>
      </geometry>
      <material name="blue_servo"/>
    </visual>
    <inertial>
      <origin xyz="0.00266 0 0.0318"/>
      <mass value="0.0797"/>
      <inertia ixx="1.75e-05" ixy="0" ixz="0" iyy="1.97e-05" iyz="0" izz="1.24e-05"/>
    </inertial>
  </link>
  <joint name="arm4_joint" type="revolute">
    <parent link="arm3"/>
    <child link="arm4"/>
    <origin xyz="0 0 0.08285"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Wrist camera (fixed to arm4) -->
  <link name="wrist_camera_link">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/DCW2.stl"/>
      </geometry>
      <material name="dark_plastic">
        <color rgba="0.18 0.18 0.18 1"/>
      </material>
    </visual>
  </link>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="arm4"/>
    <child link="wrist_camera_link"/>
    <origin xyz="-0.0484 0.00245 0.0672" rpy="0.028287 -1.570796 0"/>
  </joint>

  <!-- Arm joint 5 -->
  <link name="arm5">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/arm5.stl"/>
      </geometry>
      <material name="blue_servo"/>
    </visual>
    <inertial>
      <origin xyz="0.0186 -0.00247 0.0265"/>
      <mass value="0.0410"/>
      <inertia ixx="5.48e-06" ixy="0" ixz="0" iyy="1.91e-06" iyz="0" izz="5.25e-06"/>
    </inertial>
  </link>
  <joint name="arm5_joint" type="revolute">
    <parent link="arm4"/>
    <child link="arm5"/>
    <origin xyz="0.00057 0 0.074815"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
  </joint>

  <!-- Gripper housing (stationary, fixed to arm5) -->
  <link name="gripping_housing">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/Gripping.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="2.4e-06" ixy="0" ixz="0" iyy="1.5e-06" iyz="0" izz="3.9e-06"/>
    </inertial>
  </link>
  <joint name="gripping_housing_joint" type="fixed">
    <parent link="arm5"/>
    <child link="gripping_housing"/>
    <origin xyz="-0.000625 0.00024 0.093235" rpy="3.108257 -1.570792 -3.108286"/>
  </joint>

  <!-- Gripper: right finger chain (primary actuated joint) -->
  <link name="rlink1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rlink1.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0.00809 0.000355 -0.000465"/>
      <mass value="0.00470"/>
      <inertia ixx="5.46e-07" ixy="0" ixz="0" iyy="4.54e-07" iyz="0" izz="1.01e-07"/>
    </inertial>
  </link>
  <joint name="rlink1_joint" type="revolute">
    <parent link="arm5"/>
    <child link="rlink1"/>
    <origin xyz="-0.0047503 -0.012625 0.029275" rpy="1.570801 -0.604091 -1.570801"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.95" upper="0" effort="100" velocity="1"/>
  </joint>

  <link name="rlink2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rlink2.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0.02257 0.00616 -0.005"/>
      <mass value="0.00614"/>
      <inertia ixx="1.58e-06" ixy="0" ixz="0" iyy="1.54e-06" iyz="0" izz="4.67e-08"/>
    </inertial>
  </link>
  <joint name="rlink2_joint" type="continuous">
    <parent link="rlink1"/>
    <child link="rlink2"/>
    <origin xyz="0.03 0 0.001" rpy="0 0 0.9667"/>
    <axis xyz="0 0 1"/>
    <mimic joint="rlink1_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- Gripper: left finger chain (mimics rlink1_joint via MuJoCo equality constraints) -->
  <link name="llink1">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/llink1.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0.00885 -0.000342 -0.000169"/>
      <mass value="0.00427"/>
      <inertia ixx="5.37e-07" ixy="0" ixz="0" iyy="4.56e-07" iyz="0" izz="8.80e-08"/>
    </inertial>
  </link>
  <joint name="llink1_joint" type="continuous">
    <parent link="arm5"/>
    <child link="llink1"/>
    <origin xyz="-0.0044997 0.012375 0.029275" rpy="-1.570799 -0.603181 1.570799"/>
    <axis xyz="0 0 1"/>
    <mimic joint="rlink1_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="llink2">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/llink2.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0.02263 -0.00593 -0.00525"/>
      <mass value="0.00614"/>
      <inertia ixx="1.58e-06" ixy="0" ixz="0" iyy="1.54e-06" iyz="0" izz="4.67e-08"/>
    </inertial>
  </link>
  <joint name="llink2_joint" type="continuous">
    <parent link="llink1"/>
    <child link="llink2"/>
    <origin xyz="0.03 0 0.00125" rpy="0 0 -0.96762"/>
    <axis xyz="0 0 1"/>
    <mimic joint="rlink1_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <!-- Gripper: fingertip pads (mimic rlink1_joint via MuJoCo equality constraints) -->
  <link name="rlink3">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/rlink3.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0.01479 0 -0.00271"/>
      <mass value="0.00271"/>
      <inertia ixx="1.64e-07" ixy="0" ixz="0" iyy="1.63e-07" iyz="0" izz="9.18e-09"/>
    </inertial>
  </link>
  <joint name="rlink3_joint" type="continuous">
    <parent link="arm5"/>
    <child link="rlink3"/>
    <origin xyz="-0.0045001 -0.0044999 0.047275" rpy="1.570799 -0.612611 -1.570799"/>
    <axis xyz="0 0 1"/>
    <mimic joint="rlink1_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="llink3">
    <visual>
      <geometry>
        <mesh filename="package://m3pro_description/meshes/llink3.stl"/>
      </geometry>
      <material name="silver_bracket"/>
    </visual>
    <inertial>
      <origin xyz="0.01479 0 -0.00271"/>
      <mass value="0.00271"/>
      <inertia ixx="1.64e-07" ixy="0" ixz="0" iyy="1.63e-07" iyz="0" izz="9.18e-09"/>
    </inertial>
  </link>
  <joint name="llink3_joint" type="continuous">
    <parent link="arm5"/>
    <child link="llink3"/>
    <origin xyz="-0.0044999 0.0045001 0.047275" rpy="-1.570799 -0.615160 1.570799"/>
    <axis xyz="0 0 1"/>
    <mimic joint="rlink1_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- ros2_control hardware interface for MuJoCo -->
  <ros2_control name="mujoco_ros2_control" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <!-- Wheel joints use <motor> (effort) actuators in the MJCF, driven by a
           velocity command_interface (from mecanum_drive_controller); this PID
           config lets the hardware interface convert commanded velocity into effort. -->
      <param name="pids_config_file">$(find m3pro_mujoco_sim)/config/wheel_pids.yaml</param>
    </hardware>

    <!-- Wheel joints: velocity command, position+velocity state -->
    <joint name="lwheel1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rwheel1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lwheel2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rwheel2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm joints: position command, position+velocity state -->
    <joint name="arm1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm4_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm5_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper joint -->
    <joint name="rlink1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


  </ros2_control>

</robot>
